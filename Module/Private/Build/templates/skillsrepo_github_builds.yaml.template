---
name: builds
on:
  pull_request:
    branches:
      - main

permissions: {}

jobs:
  check-changes:
    runs-on: ubuntu-latest
    permissions:
      pull-requests: read
    outputs:
      relevant: ${{ steps.filter.outputs.relevant }}
    steps:
      - name: check-relevant-changes
        id: filter
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          FILES=$(gh pr view ${{ github.event.pull_request.number }} \
            --repo ${{ github.repository }} \
            --json files --jq '.files[].path')
          if echo "$FILES" | grep -iqE '^(skills/|pages/|\.build/|\.config/|nuget\.config$)'; then
            echo "relevant=true" >> "$GITHUB_OUTPUT"
          else
            echo "No relevant files changed, skipping build"
            echo "relevant=false" >> "$GITHUB_OUTPUT"
          fi

  BuildTestAndCheck:
    needs: check-changes
    if: needs.check-changes.outputs.relevant == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      contents: read
    steps:
      # Step 1: Checkout the repo
      - name: checkout-repo
        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6
        with:
          path: ###REPO_NAME###
      # Step 2: Install Node.js (required to build the Astro docs)
      - name: setup-node
        uses: actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38 # v6
        with:
          node-version: '22'
      # Step 3: Run the build script
      - name: run-build-script
        shell: pwsh
        run: |
            ./###REPO_NAME###/.build/build.ps1 `
              -GitHubRepoName '###REPO_NAME###' `
              -BranchName $env:GITHUB_REF `
              -Build 'BuildTestAndCheck' `
              -Verbose
